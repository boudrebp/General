pipeline {
  agent any

  parameters {
    string(name: 'REPO_URL', defaultValue: 'https://github.com/boudrebp/General.git', description: 'GitHub repository URL')
    string(name: 'REPO_BRANCH', defaultValue: 'main', description: 'Git branch to monitor')
    string(name: 'TARGET_FILE', defaultValue: 'coded_translation_sync/CodedTranslationConfigSample.xml', description: 'Path to source XML file within repo')
    booleanParam(name: 'ENABLE_SECONDARY_DB', defaultValue: false, description: 'Enable writes to secondary Oracle DB using DB2 credentials')
    string(name: 'PRIMARY_DB_DSN', defaultValue: 'ALHXVS1ETOR01:1521/eta', description: 'Primary Oracle DSN host:port/service')
    string(name: 'SECONDARY_DB_DSN', defaultValue: 'IRVXVS1ETOR01:1521/eta_b', description: 'Secondary Oracle DSN host:port/service')
  }

  triggers {
    pollSCM('H/15 * * * *')
  }

  options {
    disableConcurrentBuilds()
    timestamps()
  }

  environment {
    TARGET_FILE = "${params.TARGET_FILE}"
    SYNC_SCRIPT = 'coded_translation_sync/scripts/sync_coded_translation.py'
    PY_REQUIREMENTS = 'coded_translation_sync/requirements.txt'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: "*/${params.REPO_BRANCH}"]],
          doGenerateSubmoduleConfigurations: false,
          extensions: [],
          submoduleCfg: [],
          userRemoteConfigs: [[
            url: params.REPO_URL,
            credentialsId: 'git_token'
          ]]
        ])
      }
    }

    stage('Install Python Dependencies') {
      steps {
        sh 'python3 -m pip install --user -r "$PY_REQUIREMENTS"'
      }
    }

    stage('Upsert To Oracle') {
      steps {
        script {
          def creds = [
            usernamePassword(
              credentialsId: 'gmssi_user2',
              usernameVariable: 'ORACLE_DB_USER',
              passwordVariable: 'ORACLE_DB_PASSWORD'
            )
          ]
          def dsnEnv = ["ORACLE_DB_DSN=${params.PRIMARY_DB_DSN}"]

          if (params.ENABLE_SECONDARY_DB) {
            creds += [
              usernamePassword(
                credentialsId: 'gmssi_user2',
                usernameVariable: 'ORACLE_DB2_USER',
                passwordVariable: 'ORACLE_DB2_PASSWORD'
              )
            ]
            dsnEnv += ["ORACLE_DB2_DSN=${params.SECONDARY_DB_DSN}"]
          }

          withCredentials(creds) {
            withEnv(dsnEnv) {
              sh '''#!/usr/bin/env bash
                set -euo pipefail
                python3 "$SYNC_SCRIPT" \
                  --xml-file "$TARGET_FILE" \
                  --create-table-if-missing \
                  --since-commit "${GIT_PREVIOUS_SUCCESSFUL_COMMIT:-}" \
                  --current-commit "${GIT_COMMIT:-}" \
                  --repo-dir . \
                  --source-commit "${GIT_COMMIT:-}"
              '''
            }
          }
        }
      }
    }
  }

  post {
    success {
      echo 'Pipeline completed successfully.'
    }
    failure {
      echo 'Pipeline failed. Check logs for details.'
    }
  }
}
